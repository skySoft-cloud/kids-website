---
// 全站交互增强（GSAP 驱动）：
// 滚动浮现 batch / hero 入场编排 / 页头插画视差 / 逐日时间线生长 / 数字滚动
// 以及：清单打卡记忆、sub-nav scrollspy、可滚动行渐隐自适应
// 全部通过 astro:page-load 驱动，View Transitions 换页后自动重建
---

<style is:global>
  /* 清单打卡 */
  .checklist .check-item {
    cursor: pointer;
    transition: border-color .15s ease, background .15s ease;
  }

  .checklist .check-item:hover {
    border-color: var(--c-line-strong);
  }

  .checklist .check-item.done .check-text {
    color: var(--c-ink-3);
  }

  .checklist .check-item.done .check-text .check-label {
    text-decoration: line-through;
    text-decoration-color: var(--c-line-strong);
  }

  /* 组进度条（由 JS 插入清单顶部） */
  .check-progress {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-8) var(--space-16);
    background: var(--c-surface-muted);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-full);
    font-size: 13px;
    color: var(--c-ink-2);
    margin-bottom: var(--space-4);
  }

  .check-progress .cp-track {
    flex: 1;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--c-line);
    overflow: hidden;
  }

  .check-progress .cp-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-full);
    background: var(--c-sage);
    transition: width .4s cubic-bezier(.22, 1, .36, 1);
  }

  .check-progress .cp-num {
    font-weight: 600;
    color: var(--c-ink);
    flex-shrink: 0;
  }

  /* 可滚动行动态渐隐：JS 依据滚动位置添加 .fade-l / .fade-r，两侧都滚到底时不再渐隐 */
  .sub-nav.fade-r,
  .cat-nav.fade-r,
  .tabs.fade-r,
  .recipe-filter.fade-r {
    -webkit-mask: linear-gradient(90deg, #000 0%, #000 calc(100% - 28px), transparent 100%);
    mask: linear-gradient(90deg, #000 0%, #000 calc(100% - 28px), transparent 100%);
  }

  .sub-nav.fade-l,
  .cat-nav.fade-l,
  .tabs.fade-l,
  .recipe-filter.fade-l {
    -webkit-mask: linear-gradient(90deg, transparent 0%, #000 28px, #000 100%);
    mask: linear-gradient(90deg, transparent 0%, #000 28px, #000 100%);
  }

  .sub-nav.fade-l.fade-r,
  .cat-nav.fade-l.fade-r,
  .tabs.fade-l.fade-r,
  .recipe-filter.fade-l.fade-r {
    -webkit-mask: linear-gradient(90deg, transparent 0%, #000 28px, #000 calc(100% - 28px), transparent 100%);
    mask: linear-gradient(90deg, transparent 0%, #000 28px, #000 calc(100% - 28px), transparent 100%);
  }

  /* 逐日时间线（kg-first-week）：左侧铁轨 + 节点 */
  .day-timeline {
    position: relative;
    padding-left: var(--space-28);
  }

  .day-timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--c-line);
  }

  .day-timeline .tl-progress {
    position: absolute;
    left: 15px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--c-clay);
    transform-origin: top;
    transform: scaleY(0);
  }

  .day-timeline .day-card {
    position: relative;
  }

  .day-timeline .day-card::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-28) + 10px);
    top: 26px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c-bg);
    border: 3px solid var(--c-clay);
    box-shadow: 0 0 0 4px var(--c-bg);
  }

  @media (max-width: 640px) {
    .day-timeline { padding-left: var(--space-20); }
    .day-timeline::before,
    .day-timeline .tl-progress { left: 8px; }
    .day-timeline .day-card::before {
      left: calc(-1 * var(--space-20) + 3px);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ctx: gsap.Context | null = null;
  let cleanups: Array<() => void> = [];

  function hashText(t: string): string {
    let h = 0;
    for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) | 0;
    return (h >>> 0).toString(36);
  }

  /** 可滚动行渐隐自适应：依滚动位置在左右缘显示/隐藏渐隐，滚动中实时更新 */
  function initScrollMasks() {
    const rows = document.querySelectorAll<HTMLElement>('.sub-nav, .cat-nav, .tabs, .recipe-filter');
    const update = (el: HTMLElement) => {
      const max = el.scrollWidth - el.clientWidth;
      el.classList.toggle('fade-l', max > 4 && el.scrollLeft > 4);
      el.classList.toggle('fade-r', max > 4 && el.scrollLeft < max - 4);
    };
    const check = () => rows.forEach(update);
    check();
    rows.forEach((el) => {
      el.addEventListener('scroll', () => update(el), { passive: true });
    });
    window.addEventListener('resize', check, { passive: true });
    cleanups.push(() => window.removeEventListener('resize', check));
  }

  /** sub-nav scrollspy：滚动时高亮当前所在小节 */
  function initScrollSpy() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sub-nav a[href^="#"]'));
    if (links.length < 2) return;
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute('href')!.slice(1);
      const sec = document.getElementById(id);
      if (sec) map.set(id, a);
    });
    if (map.size < 2) return;

    const setActive = (id: string | null) => {
      links.forEach((a) => a.classList.remove('active'));
      if (id) map.get(id)?.classList.add('active');
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) setActive(en.target.id);
        });
      },
      { rootMargin: '-20% 0px -65% 0px', threshold: 0 }
    );
    map.forEach((_a, id) => {
      const sec = document.getElementById(id);
      if (sec) io.observe(sec);
    });
    // 回到页顶时恢复第一项
    const onScroll = () => {
      if (window.scrollY < 120) {
        links.forEach((a) => a.classList.remove('active'));
        links[0].classList.add('active');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    cleanups.push(() => window.removeEventListener('scroll', onScroll));
  }

  /** 清单打卡：点击切换 + localStorage 记忆 + 组进度条 */
  function initChecklists() {
    const path = location.pathname;
    document.querySelectorAll('.checklist').forEach((group) => {
      const g = group as HTMLElement;
      const items = Array.from(g.querySelectorAll<HTMLElement>(':scope > .check-item'));
      if (!items.length || g.dataset.ckInit) return;
      g.dataset.ckInit = '1';

      const bar = document.createElement('div');
      bar.className = 'check-progress';
      bar.innerHTML =
        '<span>已完成</span><span class="cp-track"><span class="cp-fill"></span></span><span class="cp-num"></span>';
      g.prepend(bar);
      const fill = bar.querySelector('.cp-fill') as HTMLElement;
      const num = bar.querySelector('.cp-num') as HTMLElement;

      const sync = () => {
        const done = items.filter((it) => it.classList.contains('done')).length;
        fill.style.width = Math.round((done / items.length) * 100) + '%';
        num.textContent = done + ' / ' + items.length;
      };

      items.forEach((item, i) => {
        const key = 'pgck:' + path + ':' + i + ':' + hashText(item.textContent!.trim().slice(0, 24));
        if (localStorage.getItem(key) === '1') item.classList.add('done');
        item.addEventListener('click', () => {
          const on = item.classList.toggle('done');
          localStorage.setItem(key, on ? '1' : '0');
          sync();
        });
      });
      sync();
    });
  }

  /** GSAP 动效：滚动浮现 / hero 入场 / 视差 / 时间线 / 数字滚动 */
  function initMotion() {
    if (REDUCED) return;
    ctx?.revert();
    ctx = gsap.context(() => {
      // 1. 卡片滚动浮现（批量 + 组内错峰）
      const cards = gsap.utils.toArray<HTMLElement>(
        '.game-card, .recipe-card, .info-card, .pillar-card, .role-play, .allergy-card, .tip-box, .site-note, .data-table-wrap, .day-timeline .day-card'
      );
      if (cards.length) {
        gsap.set(cards, { opacity: 0, y: 20, scale: 0.985 });
        ScrollTrigger.batch(cards, {
          start: 'top 92%',
          once: true,
          onEnter: (batch) =>
            gsap.to(batch, {
              opacity: 1,
              y: 0,
              scale: 1,
              duration: 0.6,
              ease: 'power3.out',
              stagger: 0.055,
              overwrite: true,
              clearProps: 'transform',
            }),
        });
      }

      // 2. 首页 hero 入场编排
      const heroParts = gsap.utils.toArray<HTMLElement>(
        '.hero .hero-kicker, .hero .hero-title, .hero .hero-lead, .hero .hero-edition, .hero .hero-art'
      );
      if (heroParts.length) {
        gsap.set(heroParts, { opacity: 0, y: 24 });
        gsap.to(heroParts, {
          opacity: 1,
          y: 0,
          duration: 0.75,
          ease: 'power3.out',
          stagger: 0.09,
          delay: 0.05,
          clearProps: 'transform',
        });
      }

      // 3. 页头插画轻微视差（hero 插画由入场编排负责，避免 transform 冲突）
      gsap.utils.toArray<HTMLElement>('.page-header .header-art').forEach((art) => {
        gsap.fromTo(
          art,
          { yPercent: -3 },
          {
            yPercent: 3,
            ease: 'none',
            scrollTrigger: { trigger: art, start: 'top top', end: 'bottom top', scrub: 0.6 },
          }
        );
      });

      // 4. 逐日时间线：陶土进度线随滚动生长
      const tl = document.querySelector<HTMLElement>('.day-timeline');
      if (tl) {
        const prog = tl.querySelector<HTMLElement>('.tl-progress');
        if (prog) {
          gsap.to(prog, {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: tl,
              start: 'top 70%',
              end: 'bottom 60%',
              scrub: 0.5,
            },
          });
        }
      }

      // 5. 数字滚动（[data-count]）
      gsap.utils.toArray<HTMLElement>('[data-count]').forEach((el) => {
        const end = parseFloat(el.dataset.count || '0');
        if (!end) return;
        const state = { v: 0 };
        gsap.to(state, {
          v: end,
          duration: 1.1,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 92%', once: true },
          onUpdate: () => {
            el.textContent = String(Math.round(state.v));
          },
        });
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initScrollMasks();
    initScrollSpy();
    initChecklists();
    initMotion();
  });

  document.addEventListener('astro:before-swap', () => {
    ctx?.revert();
    ctx = null;
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>
