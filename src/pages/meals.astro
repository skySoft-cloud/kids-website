---
// 食谱库已数据化：77 道食谱存于 src/data/recipes.json，加菜改菜直接编辑该文件
// 餐桌素养 / 餐桌对话两章与亲子游戏库的素养游戏互链，改游戏名记得同步
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import recipesData from '../data/recipes.json';

const cats = recipesData.categories;
const allRecipes = recipesData.recipes;

// 本周菜单生成器：精简索引（名称/用时/标签/食材）+ 晚餐随机池（主食荤素汤，不含饮品水果）
const menuIndex = allRecipes.map((r) => ({
  name: r.name,
  time: r.meta.find((m) => m.indexOf('分钟') >= 0) ?? '',
  tag: r.tag ?? '',
  ingredients: r.ingredients,
  cat: r.cat,
}));
const DINNER_CATS = ['quick', 'staple', 'steamed', 'fried', 'braised', 'soup'];
const dinnerPool = menuIndex.filter((r) => DINNER_CATS.includes(r.cat)).map((r) => r.name);
---

<Base title="无敏食谱搭配">
  <div class="container">
    <div class="legacy-content">
<div class="page-header has-art">
      <img class="header-art" src="/art/meals.svg" alt="米饭和蔬菜的黏土风插画" width="480" height="360" loading="lazy" />
      <div class="ph-text">
        <div class="breadcrumb">
          <a href="/">首页</a> <span>/</span> 健康守护 <span>/</span> 无敏食谱搭配
        </div>
        <h1>无敏食谱搭配</h1>
        <p class="subtitle">牛奶蛋白+鸡蛋过敏儿童的家庭餐桌——77道家常食谱 + 餐桌素养与餐桌对话：吃什么、怎么吃、怎么聊，一页解决。全家份量，一锅两吃，四川味道，超市食材，老人也能轻松操作</p>
      </div>
    </div>

    <nav class="sub-nav">
      <a href="#sec1">营养速查</a>
      <a href="#sec2">买菜参考</a>
      <a href="#sec3">食谱库</a>
      <a href="#sec4">搭配公式</a>
      <a href="#sec5">一周菜单</a>
      <a href="#sec6">餐桌素养</a>
      <a href="#sec7">挑食应对</a>
      <a href="#sec8">餐桌对话</a>
      <a href="#sec9">幼儿园加餐</a>
      <a href="#sec10">隐藏过敏原</a>
      <a href="#sec11">调味料安全</a>
      <a href="#sec12">安全清单</a>
      <a href="#sec13">外出就餐</a>
      <a href="#sec14">烘焙替代</a>
      <a href="#sec15">幼儿园食谱</a>
    </nav>

    <div class="tip-box">
      <div class="tip-label">核心原则</div>
      <p>严格回避牛奶蛋白和鸡蛋。<strong>全家一锅出，孩子先盛</strong>——做菜时在加辣调味前先盛出孩子的份，大人继续加豆瓣酱、干辣椒、花椒。蛋白质靠肉、鱼、虾、豆腐替代；钙靠豆腐、深绿蔬菜、强化植物奶；做菜以蒸、煮、炖、炒为主，食材超市都能买到。</p>
    </div>

    <!-- 营养替代方案 -->
    <section class="section" id="sec1">
      <h2 class="section-title"><span class="num">1</span>营养替代速查</h2>
      <div class="tabs">
        <button class="tab-btn active" onclick="switchTab(this,'tab-protein')">蛋白质</button>
        <button class="tab-btn" onclick="switchTab(this,'tab-calcium')">钙</button>
        <button class="tab-btn" onclick="switchTab(this,'tab-vitamin')">维生素/铁/锌</button>
      </div>

      <div class="tab-panel active" id="tab-protein">
        <div class="data-table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>替代来源</th><th>适合做法</th><th>参考量（3-4人份）</th></tr>
            </thead>
            <tbody>
              <tr><td>瘦肉（猪、牛、鸡）</td><td>肉末、肉丸、蒸肉饼、肉丝、焖饭</td><td>150-250克/餐</td></tr>
              <tr><td>鱼虾</td><td>清蒸鱼、虾仁、鱼丸、烧鱼</td><td>1条鱼或150克虾/餐</td></tr>
              <tr><td>大豆制品</td><td>豆腐、豆干、豆浆、腐竹</td><td>1块豆腐或1杯豆浆/餐</td></tr>
              <tr><td>谷物</td><td>燕麦、小米、玉米、藜麦</td><td>2杯米/餐</td></tr>
              <tr><td>植物奶</td><td>豆浆、燕麦奶、米奶（强化钙）</td><td>每人1-2杯/天</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="tab-panel" id="tab-calcium">
        <div class="info-grid">
          <div class="info-card">
            <h3>豆腐（北豆腐/老豆腐）</h3>
            <p>钙含量较高，每餐可用半块到1块。蒸、炖、煮、炒均可。</p>
          </div>
          <div class="info-card">
            <h3>深绿色蔬菜</h3>
            <p>小油菜、小白菜、菠菜焯水后、藤菜尖。每餐保证1-2种。</p>
          </div>
          <div class="info-card">
            <h3>芝麻酱</h3>
            <p>拌面、抹馒头、蘸料。热量高，每人一小勺即可。</p>
          </div>
          <div class="info-card">
            <h3>强化植物奶</h3>
            <p>选配料表强化钙和维生素D的豆浆、燕麦奶。</p>
          </div>
          <div class="info-card">
            <h3>小鱼小虾</h3>
            <p>银鱼、虾皮，注意盐分，汤里少量添加。</p>
          </div>
          <div class="info-card">
            <h3>钙剂补充</h3>
            <p>如食物摄入不足，由医生评估后补充。</p>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="tab-vitamin">
        <div class="data-table-wrap">
          <table class="data-table">
            <thead>
              <tr><th>营养素</th><th>可替代食物</th></tr>
            </thead>
            <tbody>
              <tr><td>维生素A</td><td>胡萝卜、南瓜、红薯、菠菜、西兰花</td></tr>
              <tr><td>B族维生素</td><td>全谷物、杂粮、豆类、瘦肉</td></tr>
              <tr><td>维生素D</td><td>适量晒太阳、强化食品、遵医嘱补充</td></tr>
              <tr><td>铁</td><td>瘦红肉、动物肝脏少量、豆腐、黑木耳</td></tr>
              <tr><td>锌</td><td>瘦肉、鱼类、豆类、坚果碎（防呛咳）</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 四川家庭买菜参考 -->
    <section class="section" id="sec2">
      <h2 class="section-title"><span class="num">2</span>四川家庭买菜参考</h2>
      <p class="section-desc">超市和菜市场都能买到，以下是一周采买建议量（3-4人家庭）。</p>
      <div class="info-grid">
        <div class="info-card">
          <h3>蔬菜（每天买）</h3>
          <ul>
            <li>藤菜/空心菜、莲花白、小油菜、菠菜</li>
            <li>土豆、红薯、南瓜、山药、莲藕</li>
            <li>胡萝卜、白萝卜、莴笋、冬瓜</li>
            <li>番茄、茄子、西兰花、丝瓜</li>
            <li>姜、蒜、葱（常备）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>肉蛋水产（2-3天买）</h3>
          <ul>
            <li>瘦猪肉/排骨 500克</li>
            <li>鸡胸肉/鸡腿 2-3个</li>
            <li>鲈鱼/黔鱼 1条</li>
            <li>鲜虾 300克</li>
            <li>牛腩 500克（周末炖）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>豆制品（2天买一次）</h3>
          <ul>
            <li>老豆腐/嫩豆腐 2块</li>
            <li>豆干 4块</li>
            <li>黄豆 1袋（打豆浆）</li>
            <li>腐竹 1包（常备）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>常备干货/调味</h3>
          <ul>
            <li>大米、小米、面条（注意无蛋）</li>
            <li>芝麻酱、虾皮（补钙）</li>
            <li>生抽、老抽、醋、白糖、淀粉</li>
            <li>豆瓣酱、干辣椒、花椒（大人用）</li>
            <li>蒸肉米粉、糯米粉</li>
          </ul>
        </div>
      </div>
      <div class="tip-box warning">
        <div class="tip-label">买面条/抄手皮注意</div>
        <p>四川超市的面条和抄手皮大部分不加蛋，但一定要看配料表——有些品牌会加鸡蛋液增色。买的时候翻到背面看一眼，有"鸡蛋""蛋清""蛋黄"字样就不买。无蛋面条和抄手皮在永辉、红旗等超市都能找到。</p>
      </div>

      <h3 class="block-title">季节性买菜参考</h3>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>季节</th><th>当季蔬菜（便宜又好）</th><th>当季水果</th><th>买菜重点</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>春季（3-5月）</td>
              <td>菠菜、莴笋、莲花白、豌豆尖、芹菜、春笋</td>
              <td>草莓、枇杷、樱桃</td>
              <td>绿叶菜最多，趁便宜多买多吃</td>
            </tr>
            <tr>
              <td>夏季（6-8月）</td>
              <td>藤菜、丝瓜、冬瓜、番茄、茄子、苦瓜、黄瓜</td>
              <td>西瓜、桃子、葡萄、李子</td>
              <td>瓜类上市，清凉解暑，多煮瓜汤</td>
            </tr>
            <tr>
              <td>秋季（9-11月）</td>
              <td>莲藕、山药、南瓜、红薯、白萝卜、西兰花</td>
              <td>苹果、梨、石榴、猕猴桃</td>
              <td>根茎类上市，适合蒸、炖、焖饭</td>
            </tr>
            <tr>
              <td>冬季（12-2月）</td>
              <td>大白菜、萝卜、花菜、蒜苗、莴笋、土豆</td>
              <td>橙子、柚子、甘蔗</td>
              <td>根茎类耐储存，多炖汤暖胃</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="tip-box">
        <div class="tip-label">省钱小技巧</div>
        <p>当季菜最便宜也最营养。四川夏天藤菜1把不到2元，秋天南瓜红薯论斤买更划算。冬天大白菜一次买3-4颗，放阳台能吃一周。反季节菜（如冬天的番茄、夏天的菠菜）价格翻倍且口感差，不建议。</p>
      </div>
    </section>

    <!-- 家常食谱库 -->
    <section class="section" id="sec3">
      <h2 class="section-title"><span class="num">3</span>无敏家常食谱库</h2>
      <p class="section-desc">77道食谱，全部无牛奶无鸡蛋，按全家3-4人份设计。<strong>橙色标记"一锅两吃"</strong>的食谱在关键步骤会提醒先盛孩子的份；<strong>绿色标记"全家统一"</strong>的食谱大人小孩吃一样的。<strong>蓝色标记</strong>是新场景系列：早餐、班级分享（生日会/节日带去幼儿园的无敏零食）、生病照护（对症食疗）。</p>

      <div class="recipe-search">
        <svg class="rs-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="recipeSearch" type="search" placeholder="搜菜名或食材，如：南瓜、面条" autocomplete="off" />
        <button id="recipeSearchClear" type="button" aria-label="清空搜索" style="display:none">&times;</button>
      </div>
      <p class="search-info" id="recipeSearchInfo" hidden></p>
      <div class="recipe-filter" id="recipeFilter">
        <button class="filter-btn active" onclick="filterRecipes(this,'all')">全部</button>
        <button class="filter-btn" onclick="filterRecipes(this,'split')">一锅两吃</button>
        <button class="filter-btn" onclick="filterRecipes(this,'family')">全家统一</button>
        <button class="filter-btn" onclick="filterRecipes(this,'quick')">10分钟快手</button>
        <button class="filter-btn" onclick="filterRecipes(this,'calcium')">补钙</button>
        <button class="filter-btn" onclick="filterRecipes(this,'protein')">高蛋白</button>
        <button class="filter-btn" onclick="filterRecipes(this,'breakfast')">早餐</button>
        <button class="filter-btn" onclick="filterRecipes(this,'share')">班级分享</button>
        <button class="filter-btn" onclick="filterRecipes(this,'sick')">生病照护</button>
      </div>

      <div class="cat-nav" id="catNav">
        <a href="#cat-quick">10分钟快手</a>
        <a href="#cat-staple">主食</a>
        <a href="#cat-steamed">蒸菜</a>
        <a href="#cat-fried">炒菜</a>
        <a href="#cat-braised">烧菜/炖菜</a>
        <a href="#cat-snack">小食/点心</a>
        <a href="#cat-soup">汤品</a>
        <a href="#cat-drink">饮品</a>
        <a href="#cat-fruit">水果</a>
      </div>

      <!-- 10分钟快手菜 -->
      {cats.map((cat) => (
      <div>
        <h3 class="recipe-cat-title" id={'cat-' + cat.id}>
          {cat.name} <span class="cat-count">{cat.count}</span>
        </h3>
        <div class="recipe-grid">
          {allRecipes.filter((r) => r.cat === cat.id).map((r) => (
            <div class="recipe-card" data-scene={r.scene}>
              <div class="recipe-badge-row">
                <span class:list={['recipe-badge', r.badge ?? cat.badge]}>
                  {r.badgeLabel ?? cat.badgeLabel}
                </span>
                <span class="recipe-serving">{r.serving}</span>
                {r.tag && (
                  <span class={'recipe-tag ' + r.tag}>
                    {r.tag === 'split' ? '一锅两吃' : '全家统一'}
                  </span>
                )}
                {r.scene && <span class="recipe-tag scene">{r.scene}</span>}
              </div>
              <div class="recipe-name">{r.name}</div>
              <div class="recipe-meta">{r.meta.map((mItem, i) => <span>{i === 0 && mItem.indexOf('分钟') >= 0 && <Icon name="ph:clock" />}{mItem}</span>)}</div>
              <div class="recipe-ingredients"><strong>食材：</strong>{r.ingredients}</div>
              <div class="recipe-steps">
                {r.steps.map((s) =>
                  typeof s === 'string' ? (
                    <div>{s}</div>
                  ) : s.split ? (
                    <div class="recipe-split"><Fragment set:html={s.split} /></div>
                  ) : (
                    <div class="recipe-adult"><Fragment set:html={s.adult} /></div>
                  )
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}</section>

    <!-- 每日搭配公式 -->
    <section class="section" id="sec4">
      <h2 class="section-title"><span class="num">4</span>家庭每日搭配公式</h2>
      <p class="section-desc">全家一锅出，不用单独给孩子做。按"1主食 + 1-2菜 + 1汤 + 1水果/饮品"组合。</p>
      <div class="info-grid">
        <div class="info-card">
          <h3>早餐</h3>
          <ul>
            <li>主食：小米粥、燕麦粥、红薯粥、馒头、面条</li>
            <li>蛋白：鸡肉丝、豆腐、豆浆、肉末</li>
            <li>搭配：蒸红薯/南瓜、香蕉</li>
            <li>饮品：豆浆、植物奶</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>午餐</h3>
          <ul>
            <li>主食：米饭、杂粮饭、土豆焖饭</li>
            <li>菜1（荤）：清蒸鱼、肉末豆腐、虾仁炒青豆玉米</li>
            <li>菜2（素）：蒜蓉炒藤菜、清炒莲花白</li>
            <li>汤：番茄豆腐汤、青菜豆腐汤</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>晚餐</h3>
          <ul>
            <li>主食：粥、面条、面片</li>
            <li>菜：蒸菜为主（蒸肉饼、蒸南瓜）</li>
            <li>汤：冬瓜排骨汤、萝卜骨头汤</li>
            <li>量比午餐略少，不要太油腻</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>加餐</h3>
          <ul>
            <li>上午：水果（苹果、梨、香蕉）</li>
            <li>下午：蒸南瓜/红薯、米糕、小饼</li>
            <li>饮品：豆浆、银耳羹</li>
            <li>少量坚果碎（防呛咳）</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 一周食谱 -->
    <section class="section" id="sec5">
      <h2 class="section-title"><span class="num">5</span>家庭一周菜单</h2>
      <p class="section-desc">上半是全家共做的参考模板（加辣前先给孩子盛），下半是生成器：每天挑一道「晚餐主打」，自动保存、生成采购参考、可打印。</p>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>星期</th>
              <th>早餐</th>
              <th>午餐</th>
              <th>晚餐</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>周一</td>
              <td>小米南瓜粥 + 蒸红薯 + 豆浆</td>
              <td>杂粮饭 + 番茄炒豆腐 + 蒜蓉炒藤菜（先盛）+ 青菜豆腐汤</td>
              <td>青菜肉末抄手（先盛）+ 蒸南瓜</td>
            </tr>
            <tr>
              <td>周二</td>
              <td>燕麦粥（植物奶煮）+ 香蕉片</td>
              <td>土豆焖饭 + 青豆玉米炒虾仁 + 紫菜虾皮汤</td>
              <td>蔬菜烩面片 + 蒸肉饼</td>
            </tr>
            <tr>
              <td>周三</td>
              <td>红薯粥 + 馒头 + 鸡丝</td>
              <td>米饭 + 清蒸鲈鱼（先盛）+ 清炒莲花白（先盛）+ 番茄豆腐汤</td>
              <td>山药瘦肉粥 + 蒸红薯</td>
            </tr>
            <tr>
              <td>周四</td>
              <td>南瓜小米饭 + 豆浆 + 蒸胡萝卜</td>
              <td>米饭 + 豆腐肉末蒸碗 + 蒜蓉炒西兰花 + 菌菇豆腐汤</td>
              <td>番茄牛肉面（先盛）+ 蒸南瓜</td>
            </tr>
            <tr>
              <td>周五</td>
              <td>小米南瓜粥 + 无蛋香蕉米糕</td>
              <td>米饭 + 土豆烧鸡（先盛）+ 糖醋土豆 + 萝卜炖排骨</td>
              <td>红薯粥 + 蔬菜肉丸</td>
            </tr>
            <tr>
              <td>周六</td>
              <td>南瓜发糕 + 红枣核桃豆浆</td>
              <td>米饭 + 红烧肉末豆腐（先盛）+ 莴笋炒肉丝 + 冬瓜排骨汤</td>
              <td>番茄牛肉面（先盛）+ 蒸山药</td>
            </tr>
            <tr>
              <td>周日</td>
              <td>水果粥 + 香煎土豆饼</td>
              <td>米饭 + 粉蒸肉（先盛）+ 肉丝炒胡萝卜 + 莲藕排骨汤</td>
              <td>小米南瓜粥 + 豆腐蔬菜饼</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="tip-box">
        <div class="tip-label">一锅两吃操作要点</div>
        <p>标注"先盛"的菜在炒到8成熟或调味前，先给孩子盛出一碟，然后大人的锅再加豆瓣酱、干辣椒、花椒。汤类和蒸菜大多全家统一，不用分开。面条/抄手类在调味前先盛孩子的，大人碗里加辣椒油。</p>
      </div>

      <div class="menu-picker" id="menu-picker">
        <h3 class="mp-title">本周菜单生成器</h3>
        <p class="mp-sub">每天挑一道「晚餐主打」——选择自动保存在本机，下周打开还在；不想挑就点「随机排一周」。下面会生成一张可打印的菜单表和采购参考。</p>
        <div class="mp-days">
          {[['mon', '周一'], ['tue', '周二'], ['wed', '周三'], ['thu', '周四'], ['fri', '周五'], ['sat', '周六'], ['sun', '周日']].map(([dayId, dayLabel]) => (
            <label class="mp-day">
