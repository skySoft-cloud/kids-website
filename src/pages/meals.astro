<script>
  window.switchTab = function (btn, panelId) {
    var tabs = btn.parentElement;
    var panels = tabs.parentElement.querySelectorAll('.tab-panel');
    tabs.querySelectorAll('.tab-btn').forEach(function (b) { b.classList.remove('active'); });
    panels.forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');
    document.getElementById(panelId).classList.add('active');
  };

  var currentTag = 'all';
  var searchInput = document.getElementById('recipeSearch');
  var searchInfo = document.getElementById('recipeSearchInfo');

  function matchSearch(card, q) {
    if (!q) return true;
    return (card.textContent || '').toLowerCase().indexOf(q) >= 0;
  }

  function applyFilters() {
    var q = (searchInput && searchInput.value || '').trim().toLowerCase();
    var tag = currentTag;

    var cards = document.querySelectorAll('.recipe-card');
    var calciumKeys = ['豆腐', '虾', '芝麻', '紫菜', '虾皮', '豆浆', '牛奶'];
    var proteinKeys = ['肉', '鱼', '虾', '豆腐', '豆干', '牛肉', '鸡', '排骨', '豆浆'];
    var visibleCount = 0;

    cards.forEach(function (card) {
      var show = false;
      var name = (card.querySelector('.recipe-name') || {}).textContent || '';
      var ings = (card.querySelector('.recipe-ingredients') || {}).textContent || '';
      var meta = (card.querySelector('.recipe-meta') || {}).textContent || '';
      var hasSplit = !!card.querySelector('.recipe-tag.split');
      var hasFamily = !!card.querySelector('.recipe-tag.family');

      if (tag === 'all') {
        show = true;
      } else if (tag === 'split') {
        show = hasSplit;
      } else if (tag === 'family') {
        show = hasFamily;
      } else if (tag === 'quick') {
        // 从 meta 中提取分钟数判断，避免子串误匹配（如「25分钟」含「5分钟」）
        var mins = meta.match(/(\d+)\s*分钟/);
        show = !!mins && parseInt(mins[1], 10) <= 10;
      } else if (tag === 'calcium') {
        show = calciumKeys.some(function (k) { return name.indexOf(k) >= 0 || ings.indexOf(k) >= 0; });
      } else if (tag === 'protein') {
        show = proteinKeys.some(function (k) { return name.indexOf(k) >= 0 || ings.indexOf(k) >= 0; });
      } else if (tag === 'breakfast') {
        show = card.dataset.scene === '早餐';
      } else if (tag === 'share') {
        show = card.dataset.scene === '班级分享';
      } else if (tag === 'sick') {
        show = card.dataset.scene === '生病照护';
      }

      show = show && matchSearch(card, q);
      if (show) visibleCount++;
      card.style.display = show ? '' : 'none';
    });

    document.querySelectorAll('.recipe-cat-title').forEach(function (title) {
      var grid = title.nextElementSibling;
      if (grid && grid.classList.contains('recipe-grid')) {
        var visible = grid.querySelectorAll('.recipe-card:not([style*="display: none"])');
        var hasVisible = visible.length > 0;
        title.style.display = hasVisible ? '' : 'none';
        grid.style.display = hasVisible ? '' : 'none';
      }
    });

    if (searchInfo) {
      var filtered = q || tag !== 'all';
      searchInfo.hidden = !filtered;
      if (filtered) {
        searchInfo.textContent = visibleCount > 0
          ? '找到 ' + visibleCount + ' 道食谱' + (q ? '（含「' + searchInput.value.trim() + '」）' : '')
          : '没有匹配的食谱，换个关键词试试';
      }
    }
  }

  window.filterRecipes = function (btn, tag) {
    document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    currentTag = tag;
    applyFilters();
  };

  if (searchInput) {
    var clearBtn = document.getElementById('recipeSearchClear');
    searchInput.addEventListener('input', function () {
      clearBtn.style.display = searchInput.value ? '' : 'none';
      applyFilters();
    });
    clearBtn.addEventListener('click', function () {
      searchInput.value = '';
      clearBtn.style.display = 'none';
      applyFilters();
      searchInput.focus();
    });
  }
</script>

<script is:inline define:vars={{ menuIndex, dinnerPool }}>
  // 本周菜单生成器：选择存 localStorage，随机排菜，打印模式只出菜单表
  (function () {
    var byName = {};
    menuIndex.forEach(function (r) { byName[r.name] = r; });
    var DAYS = [['mon', '周一'], ['tue', '周二'], ['wed', '周三'], ['thu', '周四'], ['fri', '周五'], ['sat', '周六'], ['sun', '周日']];
    var KEY = 'weeklyMenu.v1';

    function load() {
      try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; }
    }
    function save(d) {
      try { localStorage.setItem(KEY, JSON.stringify(d)); } catch (e) { /* 隐私模式下静默失败 */ }
    }
    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }
    function syncSelects(d) {
      document.querySelectorAll('.mp-select').forEach(function (sel) {
        sel.value = d[sel.dataset.day] || '';
      });
    }

    function render() {
      var box = document.getElementById('menuResult');
      if (!box) return;
      var d = load();
      var picked = 0;
      var rows = '';
      var shop = [];
      DAYS.forEach(function (day) {
        var name = d[day[0]];
        if (!name || !byName[name]) {
          rows += '<tr><td>' + day[1] + '</td><td class="mp-empty">— 未选 —</td><td></td><td></td></tr>';
          return;
        }
        picked++;
        var r = byName[name];
        var label = r.tag === 'split' ? '一锅两吃' : r.tag === 'family' ? '全家统一' : '';
        rows += '<tr><td>' + day[1] + '</td><td class="mp-dish">' + esc(name) + '</td><td>' + esc(r.time) + '</td><td>' + label + '</td></tr>';
        r.ingredients.split('、').forEach(function (item) {
          var it = item.trim();
          if (it && shop.indexOf(it) < 0) shop.push(it);
        });
      });

      if (picked === 0) {
        box.hidden = true;
        box.innerHTML = '';
        return;
      }
      var html = '<h4 class="mp-result-title">本周菜单（晚餐主打）</h4>';
      html += '<div class="data-table-wrap"><table class="data-table"><thead><tr><th style="width:64px;">星期</th><th>晚餐主打</th><th style="width:110px;">用时</th><th style="width:90px;">备注</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
      html += '<p class="mp-shop"><strong>采购参考：</strong>' + (shop.length ? esc(shop.join('、')) : '—') + '</p>';
      html += '<p class="mp-note">调料按家里存货核对分量；标注「一锅两吃」的菜记得先盛孩子的份。菜单保存在本机，换设备不同步。</p>';
      box.hidden = false;
      box.innerHTML = html;
    }

    window.onMenuPick = function (sel) {
      var d = load();
      if (sel.value) { d[sel.dataset.day] = sel.value; } else { delete d[sel.dataset.day]; }
      save(d);
      render();
    };

    window.randomWeek = function () {
      var pool = dinnerPool.slice();
      for (var i = pool.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
      }
      var d = {};
      DAYS.forEach(function (day, i) { d[day[0]] = pool[i % pool.length]; });
      save(d);
      syncSelects(d);
      render();
      var box = document.getElementById('menuResult');
      if (box) box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    window.clearWeek = function () {
      save({});
      syncSelects({});
      render();
    };

    window.printWeek = function () {
      var box = document.getElementById('menuResult');
      if (!box || box.hidden) {
        alert('先给一周挑好菜（或点「随机排一周」），再打印。');
        return;
      }
      var section = box.closest('.section');
      if (section) section.classList.add('print-target');
      document.body.classList.add('print-menu');
      var done = function () {
        document.body.classList.remove('print-menu');
        if (section) section.classList.remove('print-target');
        window.removeEventListener('afterprint', done);
      };
      window.addEventListener('afterprint', done);
      window.print();
      setTimeout(done, 2000); // 部分浏览器不触发 afterprint 的兜底
    };

    syncSelects(load());
    render();
  })();
</script>