---
// 本文件由 scripts/migrate.mjs 从 _legacy/health.html 迁移生成
// 修改内容请编辑源文件后重新运行脚本，或直接调整下方标记
import Base from '../layouts/Base.astro';
---

<Base title="健康守护">
  <div class="container">
    <div class="legacy-content">
<div class="page-header has-art">
      <img class="header-art" src="/art/health.svg" alt="药品与听诊器的黏土风插画" width="480" height="360" loading="lazy" />
      <div class="ph-text">
        <div class="breadcrumb">
          <a href="/">首页</a> <span>/</span> 健康守护
        </div>
        <h1>健康守护</h1>
        <p class="subtitle">体检疫苗、口腔视力、安全急救、生长发育追踪——守护孩子每一天</p>
      </div>
    </div>

    <nav class="sub-nav" aria-label="本页小节">
      <a href="#sec1" class="active">体检疫苗</a>
      <a href="#sec2">口腔保健</a>
      <a href="#sec3">视力保护</a>
      <a href="#sec4">安全急救</a>
      <a href="#sec5">生病照护</a>
    </nav>

    <section class="section" id="sec1">
      <h2 class="section-title"><span class="num">1</span>定期体检与疫苗</h2>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>年龄</th><th>体检重点</th><th>疫苗</th></tr>
          </thead>
          <tbody>
            <tr><td>3岁</td><td>身高体重、视力筛查、口腔检查</td><td>A群C群脑膜炎疫苗（加强）</td></tr>
            <tr><td>4岁</td><td>脊柱发育、龋齿检查、听力</td><td>脊髓灰质炎疫苗（加强）</td></tr>
            <tr><td>5岁</td><td>视力复查、生长发育评估</td><td>麻疹风疹疫苗（加强）</td></tr>
            <tr><td>6岁</td><td>入学体检、全面评估</td><td>白破疫苗、流脑疫苗</td></tr>
          </tbody>
        </table>
      </div>
      <div class="tip-box">
        <div class="tip-label">提醒</div>
        <p>每年秋季入园前建议接种流感疫苗。入园初期因接触面扩大，生病频率会增加，这是正常免疫建设过程。</p>
      </div>
    </section>

    <section class="section" id="sec2">
      <h2 class="section-title"><span class="num">2</span>口腔保健</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>日常刷牙</h3>
          <ul>
            <li>每天早晚刷牙，每次2分钟</li>
            <li>使用含氟儿童牙膏（豌豆大小）</li>
            <li>家长帮助刷至6岁</li>
            <li>使用软毛小头牙刷</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>定期检查</h3>
          <ul>
            <li>每半年口腔检查一次</li>
            <li>3-4岁可做窝沟封闭</li>
            <li>发现龋齿及时治疗</li>
            <li>关注换牙时间（约6岁开始）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>饮食习惯</h3>
          <ul>
            <li>减少粘性甜食、碳酸饮料</li>
            <li>吃完东西后漱口</li>
            <li>睡前刷牙后不再进食</li>
            <li>多吃富含纤维的蔬菜水果</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="sec3">
      <h2 class="section-title"><span class="num">3</span>视力保护</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>用眼习惯</h3>
          <ul>
            <li>每天屏幕时间不超过30分钟</li>
            <li>看屏幕保持30cm以上距离</li>
            <li>每20分钟远眺20秒</li>
            <li>阅读光线充足，避免躺看</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>户外活动</h3>
          <ul>
            <li>每天户外活动至少2小时</li>
            <li>自然光有助于预防近视</li>
            <li>球类运动锻炼眼部肌肉</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>定期检查</h3>
          <ul>
            <li>每年视力筛查一次</li>
            <li>关注是否歪头看东西</li>
            <li>注意频繁揉眼、眯眼</li>
            <li>有异常及时就医</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="sec4">
      <h2 class="section-title"><span class="num">4</span>安全急救</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>居家安全</h3>
          <ul>
            <li>插座加保护盖</li>
            <li>窗户、阳台加装防护</li>
            <li>药品、清洁剂放高处</li>
            <li>热水壶、刀具远离边缘</li>
            <li>地面防滑，地毯固定</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>户外安全</h3>
          <ul>
            <li>过马路牵着手</li>
            <li>不在车前车后玩耍</li>
            <li>远离水域，不独自玩水</li>
            <li>游乐设施大人陪同</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>家庭急救箱</h3>
          <ul>
            <li>体温计、退烧药</li>
            <li>碘伏、创可贴、纱布</li>
            <li>抗过敏药（遵医嘱）</li>
            <li>急救联系电话卡</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>急救电话</h3>
          <ul>
            <li>急救：120</li>
            <li>报警：110</li>
            <li>火警：119</li>
            <li>中毒咨询：当地疾控</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="sec5">
      <h2 class="section-title"><span class="num">5</span>生病照护</h2>
      <p class="section-intro">入园后接触面扩大，生病频率上升是免疫建设的正常过程。家庭护理的原则：不硬扛也不过度就医，重点掌握「就医信号、喂药技巧、病中饮食」三件事。</p>
      <div class="info-grid">
        <div class="info-card">
          <h3>出现这些情况立即就医</h3>
          <ul>
            <li>体温 39.5℃ 以上，退烧药效果差且精神萎靡</li>
            <li>呼吸急促费力，或口唇发紫</li>
            <li>腹泻伴脱水征兆：尿量明显减少、哭时泪少、口唇干燥</li>
            <li>抽搐、意识不清、颈部僵硬</li>
            <li>呕吐不止，超过 12 小时无法进食进水</li>
            <li>发热超过 72 小时不退（无论高低烧）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>喂药小技巧</h3>
          <ul>
            <li>提前沟通「为什么要吃药」，不骗她说是糖</li>
            <li>用喂药器沿嘴角缓慢挤入，避免直冲咽喉呛咳</li>
            <li>喂完立刻给一小口水或无敏米糊压味</li>
            <li>配合「病号小护士」游戏（见亲子游戏库），让她给玩偶喂药</li>
            <li>不自行叠加复方感冒药，联合用药先问医生药师</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>病中饮食原则</h3>
          <ul>
            <li>不强迫进食，优先补液：少量多次喝温水、米汤</li>
            <li>清淡易消化：粥、烂面、蒸苹果，见<a href="/meals/">无敏食谱</a>「生病照护」系列</li>
            <li>腹泻恢复期以焦米汤、山药小米粥过渡，暂避高糖高脂</li>
            <li>忌硬塞「补身体」：肠胃需要休息而非进补</li>
            <li>恢复期 3 天内避免剧烈运动，幼儿园可酌情请假</li>
          </ul>
        </div>
      </div>
      <div class="tip-box">
        <div class="tip-label">过敏家庭提示</div>
        <p>很多儿童感冒药、营养补充剂含牛奶蛋白或鸡蛋成分（如某些复合维生素、固体饮料、益生菌含乳粉载体），购买时同样要核对配料表和过敏原提示。</p>
      </div>
    </section>

    <div class="tip-box">
      <div class="tip-label">过敏管理</div>
      <p>孩子对牛奶蛋白和鸡蛋过敏（医院确诊），目前喝植物奶替代。详细的无敏食谱和营养搭配方案请查看 <a href="/meals/">无敏食谱搭配</a> 页面。老人已了解过敏原，重点是丰富菜品种类。</p>
    </div>
    </div>
  </div>
</Base>
