---
import Base from '../layouts/Base.astro';
---

<Base title="页面走丢了">
  <div class="container">
    <div class="notfound">
      <p class="nf-code">404</p>
      <h1 class="nf-title">这一页还在成长中</h1>
      <p class="nf-desc">你要找的页面不存在或已移动。从下面的常用入口继续逛吧。</p>
      <div class="nf-links">
        <a class="nf-home" href="/">回到首页</a>
        <a href="/kindergarten/">幼儿园适应</a>
        <a href="/games/">亲子游戏</a>
        <a href="/meals/">无敏食谱</a>
        <a href="/health/">健康守护</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .notfound {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-64) var(--space-24) var(--space-96);
    text-align: center;
  }

  .nf-code {
    font-family: var(--font-serif);
    font-size: 88px;
    font-weight: 700;
    line-height: 1;
    color: var(--c-clay);
    opacity: .25;
    letter-spacing: .06em;
  }

  .nf-title {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--c-ink);
    margin: var(--space-16) 0 var(--space-8);
  }

  .nf-desc {
    font-size: 15px;
    color: var(--c-ink-2);
    margin-bottom: var(--space-32);
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-12);
  }

  .nf-links a {
    padding: 10px var(--space-20);
    border-radius: var(--radius-full);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    font-size: 14px;
    font-weight: 500;
    color: var(--c-ink-2);
    transition: all .15s ease;
  }

  .nf-links a:hover {
    border-color: var(--c-clay);
    color: var(--c-clay);
    text-decoration: none;
  }

  .nf-links a.nf-home {
    background: var(--c-clay);
    border-color: var(--c-clay);
    color: var(--c-surface);
  }

  .nf-links a.nf-home:hover {
    background: var(--c-clay-dark);
    color: var(--c-surface);
  }
</style>
