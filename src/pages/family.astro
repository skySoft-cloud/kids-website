---
// 本文件由 scripts/migrate.mjs 从 _legacy/family.html 迁移生成
// 修改内容请编辑源文件后重新运行脚本，或直接调整下方标记
import Base from '../layouts/Base.astro';
---

<Base title="家庭生活">
  <div class="container">
    <div class="legacy-content">
<div class="page-header has-art">
      <img class="header-art" src="/art/family.svg" alt="三代人放风筝的黏土风插画" width="480" height="360" loading="lazy" />
      <div class="ph-text">
        <div class="breadcrumb">
          <a href="/">首页</a> <span>/</span> 家庭生活
        </div>
        <h1>家庭生活</h1>
        <p class="subtitle">老人带娃协调、亲子时间、周末假期、情绪社交——双职工家庭的日常运营</p>
      </div>
    </div>

    <!-- 老人带娃协调 -->
    <nav class="sub-nav" aria-label="本页小节">
      <a href="#sec1" class="active">老人带娃</a>
      <a href="#sec2">亲子时间</a>
      <a href="#sec3">周末活动</a>
      <a href="#sec4">情绪社交</a>
    </nav>

    <section class="section" id="sec1">
      <h2 class="section-title"><span class="num">1</span>老人带娃协调</h2>
      <div class="tip-box">
        <div class="tip-label">现状</div>
        <p>双职工家庭，有老人帮带小孩，整体很顺利。协调痛点：老人有以前时代的生活思想（习俗日子讲究），对食材比较小心（有点瑕疵的菜不给小孩吃）。这些谨慎其实可以利用——关键是把过敏原也纳入老人的"谨慎清单"。</p>
      </div>
      <div class="info-grid">
        <div class="info-card">
          <h3>分工建议</h3>
          <ul>
            <li>老人负责白天看护、做饭、接送</li>
            <li>父母负责晚间陪伴、教育、洗澡</li>
            <li>周末父母全权负责，老人休息</li>
            <li>明确各自职责，减少交叉干预</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>饮食观念沟通</h3>
          <ul>
            <li>不否定老人的经验，先肯定再补充</li>
            <li>"妈您说得对，蔬菜确实要新鲜，另外牛奶鸡蛋这些也要注意"</li>
            <li>用医生建议背书，而非"网上说的"</li>
            <li>把过敏原清单打印贴在厨房</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>习俗处理</h3>
          <ul>
            <li>无害的习俗可以顺从（节气吃特定食物）</li>
            <li>涉及过敏原的习俗要提前沟通替代方案</li>
            <li>不要当面否定，私下温和解释</li>
            <li>给老人看食谱页面，方便照做</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>食材把关</h3>
          <ul>
            <li>老人对食材谨慎是好事，顺势引导</li>
            <li>买菜时一起看配料表</li>
            <li>新买的零食先放一两天确认安全</li>
            <li>家长自己先把关，不全交给老人判断</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 亲子时间 -->
    <section class="section" id="sec2">
      <h2 class="section-title"><span class="num">2</span>亲子时间安排</h2>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>时段</th><th>安排</th><th>重点</th></tr>
          </thead>
          <tbody>
            <tr><td>工作日晚 18:30-20:30</td><td>吃饭、游戏、洗澡、讲故事</td><td>高质量陪伴，不看手机</td></tr>
            <tr><td>工作日早 7:00-7:30</td><td>起床、洗漱、早餐</td><td>从容不催促</td></tr>
            <tr><td>周六全天</td><td>户外活动、亲子手工、逛公园</td><td>接触自然，释放精力</td></tr>
            <tr><td>周日全天</td><td>兴趣班、家庭时光、准备下周</td><td>收心，调整作息</td></tr>
          </tbody>
        </table>
      </div>
      <div class="tip-box">
        <div class="tip-label">质量比时长重要</div>
        <p>双职工每天能陪孩子的时间有限，重点是放下手机、全身心投入。哪怕只有30分钟专注的游戏时间，也比2小时心不在焉的陪伴有效。</p>
      </div>
    </section>

    <!-- 周末活动 -->
    <section class="section" id="sec3">
      <h2 class="section-title"><span class="num">3</span>周末亲子活动</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>户外类</h3>
          <ul>
            <li>公园/植物园：每周至少1次</li>
            <li>动物园/水族馆：每月1-2次</li>
            <li>郊外/农场采摘：应季安排</li>
            <li>骑行/跑步：小区或公园</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>室内类</h3>
          <ul>
            <li>图书馆绘本时间</li>
            <li>儿童博物馆/科技馆</li>
            <li>亲子手工/绘画</li>
            <li>烘焙（用无敏食谱）</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>社交类</h3>
          <ul>
            <li>约同龄小朋友家庭聚会</li>
            <li>社区活动中心</li>
            <li>兴趣班试听</li>
            <li>节日主题活动</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>生活技能类</h3>
          <ul>
            <li>一起去超市买菜（认食材）</li>
            <li>帮做饭（洗菜、搅拌）</li>
            <li>整理自己的玩具</li>
            <li>学穿脱衣服（入园准备）</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 情绪社交 -->
    <section class="section" id="sec4">
      <h2 class="section-title"><span class="num">4</span>情绪引导与社交发展</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>情绪识别</h3>
          <ul>
            <li>帮孩子命名情绪："你现在是生气了吗？"</li>
            <li>读情绪绘本：《我的情绪小怪兽》《菲菲生气了》</li>
            <li>不否定情绪，先共情再引导</li>
            <li>"妈妈知道你现在很难过"</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>入园前社交练习</h3>
          <ul>
            <li>多和同龄小朋友接触</li>
            <li>练习分享和轮流</li>
            <li>教说"可以一起玩吗"</li>
            <li>冲突时不急着介入，先观察</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>建立安全感</h3>
          <ul>
            <li>固定的睡前仪式</li>
            <li>高质量陪伴时间</li>
            <li>信守承诺（说几点接就几点接）</li>
            <li>允许带安抚物</li>
          </ul>
        </div>
        <div class="info-card">
          <h3>老人配合要点</h3>
          <ul>
            <li>统一情绪处理方式</li>
            <li>不吓唬孩子（"不要你了"）</li>
            <li>不替孩子社交，鼓励自己表达</li>
            <li>及时和父母同步异常行为</li>
          </ul>
        </div>
      </div>
    </section>
    </div>
  </div>
</Base>
